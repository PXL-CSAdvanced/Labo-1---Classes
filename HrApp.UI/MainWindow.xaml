<Window x:Class="HrApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HrApp.UI"
        mc:Ignorable="d"
        Title="*** HrApp PXL ***" Height="500" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Margin="10" Padding="10" Header="Nieuwe werknemer">
            <StackPanel>
                <Label Content="Voornaam:"/>
                <TextBox x:Name="firstNameTextBox" Margin="10,0,10,10" Padding="5"/>
                <Label Content="Achternaam:"/>
                <TextBox x:Name="lastNameTextBox" Margin="10,0,10,10" Padding="5"/>
                <Label Content="Geboortedatum:"/>
                <DatePicker x:Name="birthDatePicker" Margin="10,0,10,10" Padding="5"/>
                <Label Content="Salaris (€/maand):" />
                <TextBox x:Name="salaryTextBox" Margin="10,0,10,10" Padding="5"/>
                <Label Content="Adres:"/>
                <Grid x:Name="addressGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="streetTextBox" Margin="10,0,10,10" Padding="5" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="numberTextBox" Margin="10,0,10,10" Padding="5" Grid.Column="2"/>
                    <TextBox x:Name="zipcodeTextBox" Margin="10,0,10,10" Padding="5" Grid.Row="1"/>
                    <TextBox x:Name="cityTextBox" Margin="10,0,10,10" Padding="5" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                </Grid>
                <Button Content="Toevoegen" Click="OnAddEmployee_Clicked" Margin="10,10,10,10" Padding="5"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Huidige werknemers" Grid.Column="1" Margin="10" Padding="10">
            <ListBox x:Name="employeesListBox" SelectionMode="Single" SelectionChanged="OnSelectedEmployeeChanged"/>
        </GroupBox>
        <GroupBox Header="Selectie" Grid.Column="2" Margin="10" Padding="10">
            <StackPanel>
                <Label x:Name="firstNameLabel" Content="Voornaam" Margin="10,0,10,10" Padding="5"/>
                <Label x:Name="lastNameLabel" Content="Achternaam" Margin="10,0,10,10" Padding="5"/>
                <Label x:Name="ageLabel" Content="Leeftijd" Margin="10,0,10,10" Padding="5"/>
                <Label x:Name="salaryLabel" Content="Salaris" Margin="10,0,10,10" Padding="5"/>
                <Button Content="Salaris + 2%" Margin="10,0,10,10" Padding="5" Click="OnIncreaseSalary_Clicked"/>
                <Button Content="Salaris + 3%" Margin="10,0,10,10" Padding="5" Click="OnIncreaseSalary_Clicked"/>
                <Label x:Name="addressLabel" Content="Adres" Margin="10,0,10,10" Padding="5"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
